# Magento 2 (composer project) — track only project code & config;
# everything below is reinstalled by `composer install` or generated at runtime.

# Composer
/vendor/
/auth.json

# Runtime / generated
/generated/*
!/generated/.htaccess
/var/*
!/var/.htaccess
/pub/static/*
!/pub/static/.htaccess
/pub/media/*
!/pub/media/.htaccess

# Environment-specific config (DB credentials, crypt key)
/app/etc/env.php

# Files deployed from magento/magento2-base by composer
/dev/
/lib/
/setup/*
!/setup/config/
/setup/config/*
!/setup/config/autoload/
/setup/config/autoload/*
!/setup/config/autoload/horobyna.global.php
/phpserver/
/pub/errors/
/pub/opt/
/pub/*.php
/pub/.htaccess
/pub/.user.ini
/app/.htaccess
/app/autoload.php
/app/bootstrap.php
/app/functions.php
/app/etc/di.xml
/app/etc/NonComposerComponentRegistration.php
/app/etc/registration_globlist.php
/app/etc/vendor_path.php
/app/etc/db_schema.xml
/bin/magento
/bin/magerun
/bin/.htaccess
/.htaccess
/.htaccess.sample
/.user.ini
/*.sample
/CHANGELOG.md
/COPYING.txt
/LICENSE*.txt
/SECURITY.md
/.php-cs-fixer.dist.php
/.editorconfig

# Node / tooling
/node_modules/
/package.json
/package-lock.json
/Gruntfile.js
/grunt-config.json

# IDE / OS
/.idea/
.DS_Store
